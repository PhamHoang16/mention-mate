# ============================================================
# MentionMate — Configuration template
# ============================================================
# Copy file này thành .env (cùng thư mục) rồi điền 4 giá trị bắt buộc.
# Wizard ./setup.sh hoặc setup.ps1 sẽ làm việc này tự động — chỉ điền thủ công
# khi bạn rành CLI và muốn skip wizard.
#
# ⚠️ TUYỆT ĐỐI không commit file .env lên git. .gitignore đã chặn sẵn.
# ⚠️ Đặt permission `chmod 600 .env` (Linux/macOS) để chỉ user owner đọc được.
# ============================================================

# --- 1. Telegram API credentials ---
# Lấy tại: https://my.telegram.org/apps
# (cần đăng nhập bằng SĐT Telegram của bạn → bấm "API development tools" → "Create new application")
TG_API_ID=
TG_API_HASH=

# --- 2. Username Telegram của bạn (KHÔNG có ký tự @) ---
# Ví dụ: nếu Telegram username là @hoangp47 thì điền: hoangp47
# Bot sẽ chỉ trigger alert khi message group có chứa "@<username>" (case-insensitive).
TG_MY_USERNAME=

# --- 3. Bot Token để gửi alert (không phải đọc message) ---
# Tạo bot mới:
#   1. Mở Telegram, chat với @BotFather
#   2. Gõ /newbot
#   3. Đặt tên + username cho bot (vd: my_mention_alert_bot)
#   4. BotFather trả về token dạng: <số>:<chuỗi 35 ký tự>
# Lý do hybrid: userbot KHÔNG thể tự gửi alert cho chính mình (Telegram silent push),
# nên cần 1 bot riêng đóng vai trò "messenger".
TG_BOT_TOKEN=

# --- 4. Chat ID đích để nhận alert ---
# Wizard sẽ tự lấy giá trị này — nếu điền tay:
#   1. Mở Telegram, tìm bot vừa tạo (theo username ở trên), gửi /start
#   2. Mở https://api.telegram.org/bot<TG_BOT_TOKEN>/getUpdates trên trình duyệt
#   3. Tìm "chat":{"id":<số>,...} trong JSON — copy số đó vào đây
# Lưu ý: chat_id có thể là số âm (group) hoặc dương (DM).
TG_ALERT_CHAT_ID=
