# ============================================================
# MentionMate — Configuration template
# ============================================================
# Copy this file to .env (same directory) and fill in the 4 required values.
# Running ./setup.sh or setup.ps1 does this automatically — only fill manually
# if you're comfortable with CLI and want to skip the wizard.
#
# ⚠️ NEVER commit the .env file. .gitignore already blocks it.
# ⚠️ Set permissions to `chmod 600 .env` (Linux/macOS) so only the owner can read it.
# ============================================================

# --- 1. Telegram API credentials ---
# Get them at: https://my.telegram.org/apps
# (sign in with your Telegram phone number → click "API development tools" → "Create new application")
TG_API_ID=
TG_API_HASH=

# --- 2. Your Telegram username (WITHOUT the leading @) ---
# Example: if your Telegram username is @hoangp47, put: hoangp47
# The bot only triggers an alert when a group message contains "@<username>" (case-insensitive).
TG_MY_USERNAME=

# --- 3. Bot token used to deliver alerts (not to read messages) ---
# Create a new bot:
#   1. Open Telegram, chat with @BotFather
#   2. Send /newbot
#   3. Choose a display name and username (e.g. my_mention_alert_bot)
#   4. BotFather replies with a token like: <id>:<35-char secret>
# Why the hybrid design: a userbot CANNOT send an alert to itself
# (Telegram silently delivers self-messages with no push notification),
# so a separate bot acts as the "messenger".
TG_BOT_TOKEN=

# --- 4. Destination chat ID that receives the alerts ---
# The wizard fills this in automatically — if filling manually:
#   1. Open Telegram, find the bot you just created (by its username), send /start
#   2. Open https://api.telegram.org/bot<TG_BOT_TOKEN>/getUpdates in your browser
#   3. Find "chat":{"id":<number>,...} in the JSON — copy that number here
# Note: chat_id can be negative (group) or positive (DM).
TG_ALERT_CHAT_ID=
