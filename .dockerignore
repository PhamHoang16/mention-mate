# Secrets — NEVER include in image
.env
.env.*
*.session
*.session-journal

# Runtime data (user-side, mounted as volume)
data/

# Build artifacts
dist/
*.zip
**/*.egg-info/
src/mention_mate.egg-info/

# Python
.venv/
.venv-*/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Tests — not installed by `pip install .`
tests/

# Git
.git/
.gitignore
.gitattributes
.gitnexus/

# Wizards and orchestration (not needed inside container)
scripts/
docker-compose.yml
.dockerignore
mention-mate.sh
mention-mate.ps1

# Documentation (not needed inside container)
README.md
CHANGELOG.md
LICENSE
docs/
plans/
repomix-output.xml
.repomixignore
release-manifest.json

# AI agent machinery
.claude/
.codex/
.vsaf/
CLAUDE.md
AGENTS.md

# CI
.github/

# Backups
*.bak
*.orig

# OS/editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
